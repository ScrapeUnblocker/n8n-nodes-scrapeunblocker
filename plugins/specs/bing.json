{
	"resource": "Bing",
	"value": "bing",
	"operations": [
		{
			"name": "Search",
			"value": "search",
			"action": "Search bing",
			"description": "Get the organic results, ads and related searches Bing shows for a query",
			"endpoint": "/search/bing",
			"fields": [
				{
					"param": "keyword",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "espresso machine",
					"description": "What to search for"
				},
				{
					"param": "pages_to_check",
					"displayName": "Result Pages",
					"type": "number",
					"default": 1,
					"min": 1,
					"max": 10,
					"description": "How many result pages to collect, about 10 results each. Each page is one billed call."
				}
			],
			"options": [
				{
					"param": "language",
					"displayName": "Language",
					"type": "string",
					"placeholder": "de",
					"description": "Two-letter code of the language Bing is shown in. Empty uses English."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Bing is opened from. It sets the results market and the ads shown. Automatic uses the US."
				}
			],
			"listKeys": [
				{
					"key": "organic",
					"type": "organic"
				},
				{
					"key": "topAds",
					"type": "ad_top"
				},
				{
					"key": "bottomAds",
					"type": "ad_bottom"
				}
			],
			"test": {
				"params": {
					"keyword": "espresso machine"
				},
				"minItems": 3,
				"maxFields": 10
			}
		},
		{
			"name": "Search Images",
			"value": "searchImages",
			"action": "Search bing images",
			"description": "Find images that match a keyword, with links to the full-size image and the page it is on",
			"endpoint": "/images/bing-search",
			"fields": [
				{
					"param": "q",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "eiffel tower",
					"description": "What to search images for"
				},
				{
					"param": "pages",
					"displayName": "Result Pages",
					"type": "number",
					"default": 1,
					"min": 1,
					"max": 10,
					"description": "How many result pages to fetch, about 35 images each. Each page is one billed call."
				}
			],
			"options": [
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 0,
					"min": 0,
					"max": 400,
					"skipZero": true,
					"description": "The most images to return. 0 returns all images of the fetched pages."
				},
				{
					"param": "language",
					"displayName": "Language",
					"type": "string",
					"placeholder": "de",
					"description": "Two-letter code of the language Bing is shown in. Empty uses English."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Bing Images is opened from. It sets the Bing market. Automatic uses the US."
				}
			],
			"listKey": "results",
			"outputFields": [
				"position",
				"imageUrl",
				"sourceDomain",
				"sourcePageUrl",
				"title",
				"sourceName",
				"thumbnailUrl",
				"width",
				"height",
				"fileSize",
				"bingImagesUrl"
			],
			"idField": "imageUrl",
			"simplify": [
				"position",
				"title",
				"imageUrl",
				"sourcePageUrl",
				"sourceDomain",
				"sourceName",
				"width",
				"height",
				"thumbnailUrl",
				"bingImagesUrl"
			],
			"test": {
				"params": {
					"q": "red panda"
				},
				"options": {
					"max_results": 5
				},
				"minItems": 3,
				"maxFields": 10
			}
		}
	]
}
