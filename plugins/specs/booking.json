{
	"resource": "Booking.com",
	"value": "booking",
	"operations": [
		{
			"name": "Search Hotels",
			"value": "searchHotels",
			"action": "Search booking hotels",
			"description": "Find places to stay in a city with price, review score and address",
			"endpoint": "/travel/booking",
			"fields": [
				{
					"param": "location",
					"displayName": "Location",
					"type": "string",
					"required": true,
					"placeholder": "Paris",
					"description": "The city or place to search"
				},
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 25,
					"min": 1,
					"max": 500,
					"description": "How many places to collect, across as many result pages as needed"
				}
			],
			"options": [
				{
					"param": "checkin",
					"displayName": "Check-In Date",
					"type": "string",
					"placeholder": "2026-11-20",
					"description": "Check-in date as YYYY-MM-DD. Prices only appear when check-in and check-out dates are given."
				},
				{
					"param": "checkout",
					"displayName": "Check-Out Date",
					"type": "string",
					"placeholder": "2026-11-22",
