{
	"resource": "Google",
	"value": "google",
	"operations": [
		{
			"name": "Search",
			"value": "search",
			"action": "Search google",
			"description": "Get the organic results, ads and AI Overview Google shows for a query",
			"endpoint": "/serpApi",
			"fields": [
				{
					"param": "keyword",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "espresso machine",
					"description": "What to search for. Google search operators such as site: and quotes work."
				},
				{
					"param": "pages_to_check",
					"displayName": "Result Pages",
					"type": "number",
					"default": 1,
					"min": 1,
					"max": 10,
					"description": "How many result pages to collect, about 10 results each. Each page is one billed call."
				}
			],
			"options": [
				{
					"param": "wait_after_load",
					"displayName": "Extra Wait (Seconds)",
					"type": "number",
					"default": 0,
					"min": 0,
					"description": "Seconds to wait after each results page loads before reading it. Can help when ads show up late."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Google is opened from. Results and ads are for that country. Automatic picks any available country, so set one when the results must be for a specific market."
				}
			],
			"listKeys": [
				{
					"key": "organic",
					"type": "organic"
				},
				{
					"key": "topAds",
					"type": "ad_top"
				},
				{
					"key": "bottomAds",
					"type": "ad_bottom"
				},
				{
					"key": "aiOverview",
					"type": "ai_overview"
				}
			],
			"test": {
				"params": {
					"keyword": "espresso machine"
				},
				"minItems": 3,
				"maxFields": 10
			}
		},
		{
			"name": "Search Images",
			"value": "searchImages",
			"action": "Search google images",
			"description": "Find images that match a keyword, with links to the full-size image and the page it is on",
			"endpoint": "/images/google-search",
			"fields": [
				{
					"param": "q",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "eiffel tower",
					"description": "What to search images for"
				},
				{
					"param": "pages",
					"displayName": "Result Pages",
					"type": "number",
					"default": 1,
					"min": 1,
					"max": 5,
					"description": "How many result pages to fetch, about 100 images each. Google stops at about 400-500 images per search. Each page is one billed call."
				}
			],
			"options": [
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 0,
					"min": 0,
					"max": 500,
					"skipZero": true,
					"description": "The most images to return. 0 returns all images of the fetched pages."
				},
				{
					"param": "gl",
					"displayName": "Google Market",
					"type": "string",
					"placeholder": "de",
					"description": "Two-letter country code of the Google market whose images rank. Empty follows Browse From Country, or the US when that is automatic."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Google Images is opened from. Image results depend on the market, which follows this country unless Google Market is set."
				}
			],
			"listKey": "results",
			"test": {
				"params": {
					"q": "red panda"
				},
				"options": {
					"max_results": 5
				},
				"minItems": 3,
				"maxFields": 10
			}
		},
