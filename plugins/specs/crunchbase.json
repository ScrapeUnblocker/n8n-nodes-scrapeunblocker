{
	"resource": "Crunchbase",
	"value": "crunchbase",
	"operations": [
		{
			"name": "Get Company",
			"value": "getCompany",
			"action": "Get crunchbase company",
			"description": "Profile, funding, people, rank and web traffic of one organization",
			"endpoint": "/companies/crunchbase",
			"fields": [
				{
					"param": "organization",
					"displayName": "Organization",
					"type": "string",
					"required": true,
					"placeholder": "stripe",
					"description": "The part of the Crunchbase profile URL after /organization/ (e.g. stripe or tesla-motors), or the full profile URL"
				}
			],
			"options": [
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Crunchbase is opened from. Automatic picks one; if Crunchbase blocks the call, try another country."
				}
			],
			"itemKey": "organization",
			"outputFields": [
				"name",
				"slug",
				"uuid",
				"url",
				"legalName",
				"aliases",
				"shortDescription",
				"description",
				"logo",
