			"idField": "url",
			"simplify": [
				"name",
				"shortDescription",
				"website",
				"headquarters.city",
				"headquarters.country",
				"employeeRange",
				"industries",
				"lastFundingType",
				"rank",
				"url"
			],
			"test": {
				"params": {
					"organization": "stripe"
				},
				"minItems": 1,
				"maxItems": 1,
				"maxFields": 10
			},
			"disabled": "Crunchbase blocks the API (502 on every try, 2026-10-06)"
		},
		{
			"name": "Search Companies",
			"value": "searchCompanies",
			"action": "Search crunchbase companies",
			"description": "Find organizations by name, to look up their full profiles",
			"endpoint": "/companies/crunchbase",
			"fields": [
				{
					"param": "query",
					"displayName": "Company Name",
					"type": "string",
					"required": true,
					"placeholder": "Revolut",
					"description": "The company name to search for. Use a result's URL with Get Company for the full profile."
				},
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 10,
					"min": 1,
					"max": 25,
					"description": "How many matching organizations to return (1-25)"
				}
			],
			"options": [
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Crunchbase is opened from. Automatic picks one; if Crunchbase blocks the call, try another country."
				}
			],
			"listKey": "results",
			"test": {
				"params": {
					"query": "Revolut",
					"max_results": 3
				},
				"minItems": 1,
				"maxFields": 10
			},
			"disabled": "Crunchbase blocks the API (502 on every try, 2026-10-06)"
		}
