{
	"resource": "Tripadvisor",
	"value": "tripadvisor",
	"operations": [
		{
			"name": "Get List",
			"value": "getList",
			"action": "Get a tripadvisor list of places",
			"description": "Get the restaurants, hotels or things to do of a city from its Tripadvisor list page",
			"endpoint": "/travel/tripadvisor",
			"fields": [
				{
					"param": "url",
					"displayName": "List URL",
					"type": "string",
					"required": true,
					"placeholder": "https://www.tripadvisor.com/Restaurants-g60763-New_York_City_New_York.html",
					"description": "A Tripadvisor list page of restaurants, hotels or things to do in a city or area"
				},
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 30,
					"min": 1,
					"max": 1020,
					"description": "How many places to collect. A list page holds about 30 places, and large numbers take a while."
				}
			],
			"options": [
				{
					"param": "page",
					"displayName": "Start Page",
					"type": "number",
					"default": 1,
					"min": 1,
					"max": 34,
					"description": "Which page of the list to start from"
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Tripadvisor is opened from. Automatic picks a suitable one."
				}
			],
			"listKey": "places",
			"outputFields": [
				"name",
				"type",
				"url",
				"image",
				"rating",
				"reviewCount",
				"priceRange",
				"cuisine",
				"phone",
				"address",
				"postalCode",
				"country",
				"coordinates"
			],
			"idField": "url",
			"simplify": [
				"name",
				"type",
				"rating",
				"reviewCount",
				"priceRange",
				"cuisine",
				"address",
				"phone",
				"url",
				"image"
			],
			"test": {
				"params": {
					"url": "https://www.tripadvisor.com/Restaurants-g187147-Paris_Ile_de_France.html",
					"max_results": 5
				},
				"minItems": 3,
				"maxFields": 10
			}
		},
		{
			"name": "Get Reviews",
			"value": "getReviews",
			"action": "Get tripadvisor reviews",
			"description": "Get the reviews of a hotel, restaurant or attraction, newest first",
			"endpoint": "/travel/tripadvisor-reviews",
			"fields": [
				{
					"param": "url",
					"displayName": "Place URL",
					"type": "string",
					"placeholder": "https://www.tripadvisor.com/Hotel_Review-g60763-d93589-Reviews-The_Michelangelo_New_York-New_York_City_New_York.html",
					"description": "The review page of a hotel, restaurant or attraction on any Tripadvisor site. Enter this or a Location ID in Options."
				},
				{
					"param": "max_reviews",
					"displayName": "Max Reviews",
					"type": "number",
					"default": 20,
					"min": 1,
					"max": 200,
					"description": "How many reviews to collect. A page holds 10 reviews (15 for restaurants), and each page read is one billed call."
