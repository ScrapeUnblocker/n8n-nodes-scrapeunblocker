{
	"resource": "YouTube",
	"value": "youtube",
	"operations": [
		{
			"name": "Get Channel Videos",
			"value": "getChannelVideos",
			"action": "Get youtube channel videos",
			"description": "Retrieve the newest videos, shorts or live streams of a channel",
			"endpoint": "/content/youtube-channel",
			"fields": [
				{
					"param": "channel",
					"displayName": "Channel",
					"type": "string",
					"required": true,
					"placeholder": "@NASA",
					"description": "The channel's handle (@NASA), channel ID (UC...) or channel URL"
				},
				{
					"param": "limit",
					"name": "max_videos",
					"displayName": "Max Videos",
					"type": "number",
					"default": 30,
					"min": 1,
					"max": 200,
					"description": "How many of the channel's newest videos to return (1-200). Only the Videos tab follows it; Shorts and Live return one page."
				}
			],
			"options": [
				{
					"param": "tab",
					"displayName": "Tab",
					"type": "options",
					"default": "videos",
					"description": "Which tab of the channel to read",
					"options": [
						{
							"name": "Videos",
							"value": "videos"
						},
						{
							"name": "Shorts",
							"value": "shorts"
						},
						{
							"name": "Live",
							"value": "streams"
						}
					]
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country YouTube is opened from. Automatic picks a suitable one."
				}
			],
			"listKey": "videos",
			"outputFields": [
				"videoId",
				"title",
				"url",
				"thumbnail",
				"views",
				"published",
				"viewCount",
				"likeCount",
				"commentCount",
				"publishedAt",
				"duration",
				"durationSeconds",
				"description"
			],
			"idField": "videoId",
			"simplify": [
				"videoId",
				"title",
				"viewCount",
				"views",
				"likeCount",
				"publishedAt",
				"durationSeconds",
				"description",
				"url",
				"thumbnail"
			],
			"test": {
				"params": {
					"channel": "@NASA",
					"max_videos": 3
				},
				"minItems": 2,
				"maxFields": 10
			}
		},
		{
			"name": "Get Comments",
			"value": "getComments",
			"action": "Get youtube video comments",
			"description": "Retrieve the comments of a video with likes, replies and pinned or hearted flags",
			"endpoint": "/content/youtube-comments",
			"fields": [
				{
					"param": "video",
					"displayName": "Video",
					"type": "string",
					"required": true,
					"placeholder": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
					"description": "The video's URL (watch, youtu.be or Shorts link) or its 11-character ID"
				},
				{
					"param": "max_results",
					"displayName": "Max Comments",
					"type": "number",
					"default": 20,
					"min": 1,
					"max": 2000,
					"description": "How many comments to collect (1-2000). They come about 20 per page."
				}
			],
			"options": [
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country YouTube is opened from. Automatic uses the US."
				}
			],
			"sort": [
				{
					"param": "sort",
					"displayName": "Sort By",
					"type": "options",
					"default": "top",
					"description": "The order of the comments",
					"options": [
						{
							"name": "Top Comments",
							"value": "top"
						},
						{
							"name": "Newest First",
							"value": "newest"
						}
					]
				}
			],
			"listKey": "comments",
			"outputFields": [
				"commentId",
				"author",
				"authorChannelId",
				"authorThumbnail",
				"text",
				"likeCount",
				"likeCountText",
				"publishedTimeText",
				"replyCount",
				"isPinned",
				"pinnedText",
				"isHearted",
				"isAuthorVerified",
				"isUploader",
				"replyLevel"
			],
			"idField": "commentId",
			"simplify": [
				"commentId",
				"author",
				"text",
				"likeCount",
				"replyCount",
				"publishedTimeText",
				"isPinned",
				"isHearted",
				"isUploader",
				"authorChannelId"
			],
			"test": {
				"params": {
					"video": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
					"max_results": 3
				},
				"minItems": 2,
				"maxFields": 10
			}
		},
		{
