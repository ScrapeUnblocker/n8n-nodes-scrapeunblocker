					"type": "number",
					"default": 20,
					"min": 1,
					"max": 500,
					"description": "How many results to collect (1-500). They come about 20 per page."
				}
			],
			"options": [
				{
					"param": "type",
					"displayName": "Result Type",
					"type": "options",
					"default": "video",
