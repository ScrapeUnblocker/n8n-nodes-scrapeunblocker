		{
			"name": "Get Transcript",
			"value": "getTranscript",
			"action": "Get youtube video transcript",
			"description": "Retrieve a video's captions as timestamped segments and plain text",
			"endpoint": "/content/youtube-transcript",
			"fields": [
				{
					"param": "video",
					"displayName": "Video",
					"type": "string",
					"required": true,
					"placeholder": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
					"description": "The video's URL (watch, youtu.be or Shorts link) or its 11-character ID"
				}
			],
			"options": [
				{
					"param": "lang",
					"displayName": "Language",
					"type": "string",
					"placeholder": "en",
					"description": "The caption language code to prefer (en also matches en-US). Empty takes the video's default captions."
				},
				{
					"param": "format",
					"displayName": "Format",
					"type": "options",
					"default": "segments",
					"description": "Whether to return timestamped segments together with the joined text, or the text only",
					"options": [
						{
							"name": "Segments and Text",
							"value": "segments"
						},
						{
							"name": "Text Only",
