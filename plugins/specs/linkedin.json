						{
							"name": "$140,000+",
							"value": "140k"
						},
						{
							"name": "$160,000+",
							"value": "160k"
						},
						{
							"name": "$180,000+",
							"value": "180k"
						},
						{
							"name": "$200,000+",
							"value": "200k"
						}
					]
				},
				{
					"param": "enrich",
					"displayName": "Include Full Description",
					"type": "boolean",
					"default": false,
					"description": "Whether to also open each job for its full description, seniority, employment type, industries, applicant count and salary. Slower, and only for the first 25 jobs."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country LinkedIn is opened from. Automatic picks a suitable one."
				}
			],
			"sort": [
				{
					"param": "sort",
					"displayName": "Sort By",
					"type": "options",
					"default": "relevant",
					"description": "The order of the job postings",
					"options": [
						{
							"name": "Most Recent",
							"value": "recent"
						},
						{
							"name": "Most Relevant",
							"value": "relevant"
						}
					]
				}
			],
			"listKey": "jobs",
			"outputFields": [
