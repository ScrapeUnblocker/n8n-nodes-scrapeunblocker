{
	"resource": "Target",
	"value": "target",
	"operations": [
		{
			"name": "Search Products",
			"value": "searchProducts",
			"action": "Search target products",
			"description": "Find products that match a keyword on Target.com",
			"endpoint": "/marketplace/target-search",
			"fields": [
				{
					"param": "query",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "coffee maker",
					"description": "What to search for: a keyword or product name"
				},
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 24,
					"min": 1,
					"max": 500,
					"description": "How many products to collect across pages (up to 500)"
				}
			],
			"options": [
				{
					"param": "min_price",
					"displayName": "Min Price",
					"type": "number",
					"default": 0,
					"min": 0,
					"skipZero": true,
					"description": "Lowest price to include, as a whole number in USD. 0 means no minimum."
				},
				{
					"param": "max_price",
					"displayName": "Max Price",
					"type": "number",
					"default": 0,
					"min": 0,
					"skipZero": true,
					"description": "Highest price to include, as a whole number in USD. 0 means no limit."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Target is opened from. Automatic picks a suitable one."
				}
			],
			"sort": [
				{
					"param": "sort",
					"displayName": "Sort By",
					"type": "options",
					"default": "relevance",
					"description": "The order of the products",
					"options": [
						{
							"name": "Newest",
							"value": "newest"
						},
						{
							"name": "Price: Highest First",
							"value": "price_high"
						},
						{
							"name": "Price: Lowest First",
							"value": "price_low"
						},
						{
							"name": "Relevance",
							"value": "relevance"
						}
					]
				}
			],
			"listKey": "products",
			"test": {
				"params": {
					"query": "headphones",
					"max_results": 3
				},
				"minItems": 3,
				"maxFields": 10
			}
		}
	]
}
