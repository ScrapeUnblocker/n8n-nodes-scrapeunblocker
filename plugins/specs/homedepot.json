{
	"resource": "Home Depot",
	"value": "homeDepot",
	"operations": [
		{
			"name": "Search Products",
			"value": "searchProducts",
			"action": "Search home depot products",
			"description": "Find tools, hardware and home products that match a keyword on Home Depot",
			"endpoint": "/marketplace/homedepot-search",
			"fields": [
				{
					"param": "query",
					"displayName": "Search Query",
					"type": "string",
					"required": true,
					"placeholder": "cordless drill",
					"description": "What to search for: a keyword, product name or model number"
				},
				{
					"param": "max_results",
					"displayName": "Max Results",
					"type": "number",
					"default": 24,
					"min": 1,
					"max": 500,
					"description": "How many products to collect across pages (up to 500). A page holds about 24."
				}
			],
			"options": [
				{
					"param": "page",
					"displayName": "Start Page",
					"type": "number",
					"default": 1,
					"min": 1,
					"description": "Which results page to start from"
				},
				{
					"param": "min_price",
					"displayName": "Min Price",
					"type": "number",
					"default": 0,
					"min": 0,
					"skipZero": true,
					"description": "Lowest price to include, as a whole number in USD. 0 means no minimum."
				},
				{
					"param": "max_price",
					"displayName": "Max Price",
					"type": "number",
					"default": 0,
					"min": 0,
					"skipZero": true,
					"description": "Highest price to include, as a whole number in USD. 0 means no limit."
				},
				{
					"param": "proxy_country",
					"displayName": "Browse From Country",
					"type": "options",
					"options": "countries",
					"description": "The country Home Depot is opened from. Automatic picks a suitable one."
				}
			],
			"sort": [
				{
					"param": "sort",
					"displayName": "Sort By",
					"type": "options",
					"default": "relevance",
					"description": "The order of the products",
					"options": [
						{
							"name": "Best Selling",
							"value": "best_seller"
						},
						{
							"name": "Price: Highest First",
							"value": "price_high"
						},
						{
							"name": "Price: Lowest First",
							"value": "price_low"
						},
						{
							"name": "Relevance",
							"value": "relevance"
						},
						{
							"name": "Top Rated",
							"value": "top_rated"
						}
					]
				}
			],
			"listKey": "products",
			"outputFields": [
				"itemId",
				"title",
				"brand",
				"price",
				"originalPrice",
				"currency",
				"rating",
				"reviewCount",
				"image",
				"url",
				"modelNumber"
			],
			"idField": "itemId",
			"simplify": [
				"itemId",
				"title",
				"brand",
				"modelNumber",
				"price",
				"originalPrice",
				"rating",
				"reviewCount",
				"url",
				"image"
			],
			"test": {
				"params": {
					"query": "drill",
					"max_results": 3
				},
				"minItems": 3,
				"maxFields": 10
			}
		}
	]
}
